<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/ivBanner"
        android:layout_width="match_parent"
        android:layout_height="184dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/banner_tapas" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="545dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/ivBanner">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTitulo"
            android:text="@string/app_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textIsSelectable="false"/>
        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textIsSelectable="false"
            android:textStyle="bold"
            android:textSize="14sp"
            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:id="@+id/etBar"
            android:hint="@string/bar_name"
            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etTapa"
            android:hint="@string/tapa"
            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etPrecio"
            android:hint="@string/precio"
            android:inputType="numberDecimal"
            />
        <Space
            android:layout_width="0dp"
            android:layout_height="24dp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:onClick="like"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:text="@string/like"
                android:textSize="16sp"
                android:layout_marginEnd="10dp"
                android:id="@+id/swMeGusta"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvMeGusta"
                android:text="@string/did_u_like"
                android:layout_marginStart="12dp"
                android:textSize="16sp"
                />

        </LinearLayout>
        <CheckBox
            android:onClick="st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cbEstudiante"
            android:text="@string/descuento_estudiante"

            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLimpiar"
                android:onClick="clear"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/light_gray"
                android:text="@string/clear"/>
            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnCalcular"
                android:text="@string/calc"
                android:onClick="calcular"
                />

        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="25dp"/>

        <TextView
            android:id="@+id/tvResumen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/lighter_gray"
            android:text="@string/final_price"
            android:textSize="18sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>