<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/toolbar_bg_color"
        app:title="@string/new_review"
        app:navigationIcon="@drawable/back_arrow_ic"/>




    <!-- Reseña -->
    <Space
        android:layout_width="0dp"
        android:layout_height="5dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvTapaNameHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder"
        style="@style/main_txt"/>
        <Space
            android:layout_width="5dp"
            android:layout_height="0dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            style="@style/main_txt"
            tools:ignore="HardcodedText" />
        <Space
            android:layout_width="5dp"
            android:layout_height="0dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvBarNameHeader"
            android:text="@string/placeholder"
            style="@style/main_txt"/>
    </LinearLayout>
    <Space
        android:layout_width="110dp"
        android:layout_height="15dp"/>
    <!-- Tamaño de la tapa -->
    <RadioGroup
        android:id="@+id/sizeRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/size"
            android:textSize="20sp"
            android:textAlignment="textStart"/>
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:id="@+id/sizeRb1"
            android:text="@string/size_tapa"
            android:checked="true"/>
        <RadioButton

            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:id="@+id/sizeRb2"
            android:text="@string/size_half"/>

        <RadioButton

            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:id="@+id/sizeRb3"
            android:text="@string/size_ration"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"/>
    </RadioGroup>

    <!-- Rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RatingBar
            android:id="@+id/ratingBar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:transformPivotX="0dp"
            android:isIndicator="false"
            android:numStars="5"
            android:progressTint="@color/rating_star"
            android:rating="0"/>

        <TextView
            android:id="@+id/tvRating"
            android:layout_width="fill_parent"
            android:layout_gravity="center_vertical"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="@string/not_rated"
            android:textSize="16sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/value_for_money"
            android:textSize="18sp"/>

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:max="10"
            android:progress="5"
            android:progressTint="@color/main_theme"
            android:progressBackgroundTint="@color/orange"

            />
        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/10"
            android:textSize="24sp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <CheckBox
            android:id="@+id/cbVegan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="1"
            android:text="@string/vegetarian"/>
        <CheckBox
            android:id="@+id/cbGlutenFree"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:layout_weight="1"
            android:text="@string/gluten_free"/>
        <CheckBox
            android:id="@+id/cbSpicy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="1"
            android:text="@string/spicy"/>
    </LinearLayout>





    <!-- Botón de like -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swMeGusta"
            android:layout_width="125dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/like"
            android:textSize="16sp"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorSecondary"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvMeGusta"
            android:text="@string/did_u_like"
            android:layout_marginStart="12dp"
            android:textSize="16sp"
            />

    </LinearLayout>
    <CheckBox
        android:onClick="checkStudentId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/cbEstudiante"
        android:text="@string/descuento_estudiante"

        />

    <EditText
        android:id="@+id/editTextTextMultiLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:ems="10"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:maxLength="200"
        android:maxLines="7"
        android:hint="@string/optional_review"
        tools:ignore="Autofill" />

    <!-- Botones Finales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_weight="7"
            android:layout_height="match_parent"
            android:text="@string/clear"/>
        <Space
            android:layout_height="match_parent"
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_weight="1"/>
        <Button
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_weight="7"
            android:layout_height="wrap_content"
            android:id="@+id/btnCalcular"
            android:text="@string/publish"
            android:onClick="calcular"/>

    </LinearLayout>

    <Space
        android:layout_width="wrap_content"
        android:layout_height="25dp"/>

    <TextView
        android:id="@+id/tvResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/final_price"
        android:textSize="18sp"/>

</LinearLayout>